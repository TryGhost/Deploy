{
    extends: ['local>TryGhost/renovate-config'],
    customManagers: [
        {
            customType: 'regex',
            managerFilePatterns: ['/^\\.github/workflows/ci\\.yml$/'],
            matchStrings: [
                '# renovate: pinned-node\\s+- [\'"](?<currentValue>\\d+\\.\\d+\\.\\d+)[\'"]',
            ],
            depNameTemplate: 'node',
            datasourceTemplate: 'node-version',
            versioningTemplate: 'node',
        },
    ],
    packageRules: [
        {
            description: 'Keep CI runtime jobs pinned to Node 22.23.4; it is the engines floor and the exact Ghost(Pro) server runtime, so it must not drift to patch releases.',
            matchManagers: ['github-actions', 'custom.regex'],
            matchDepNames: ['node'],
            matchCurrentValue: '22.23.4',
            allowedVersions: '/^22\\.23\\.4$/',
        },
        {
            description: 'Keep the deploy e2e runner and SSH target on the Ghost(Pro) server runtime.',
            matchDatasources: ['docker'],
            matchPackageNames: ['node'],
            matchFileNames: ['test/e2e/**'],
            allowedVersions: '/^22\\.23\\.4-bookworm$/',
        },
    ],
}
